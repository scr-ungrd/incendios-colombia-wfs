# ====== Datos crudos (NO subir: pesados, solo para preprocesamiento) ======
# Limites originales DANE (34 MB y 203 MB)
divipola/
# GeoJSON de incendios crudos por año (2019, 2020, ... 2029).
# El patron cubre TODAS las carpetas de año sin listarlas una por una y NO
# afecta a data/processed/ (que no empieza por "20").
data/20*/
# Carpetas de respaldo local (copias manuales del dataset)
data - copia/
data*copia/
# Cualquier otro crudo
*.kml
*.csv.gz

# ====== Python ======
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
ENV/

# ====== Streamlit ======
.streamlit/secrets.toml

# ====== Sistema operativo ======
.DS_Store
Thumbs.db
desktop.ini

# ====== Editores ======
.vscode/
.idea/

# ====== Temporales / salidas locales ======
*.log
incendios_*.csv
reporte_*.pdf

# ====== Datos: subir SOLO el parquet (liviano), no el CSV pesado ======
# El dashboard lee de incendios.parquet (~19 MB). El incendios.csv (>100 MB)
# es solo un respaldo legible local y NO debe subirse (supera el límite de GitHub).
data/processed/incendios.csv
